{
  "CHEQUE ACTIONS": {
    "type": "SQL",
    "query": "SELECT CASE :APP_LANGUAGE\n           WHEN 'ar' THEN NVL(action_name_ar, action_name_en)\n           ELSE action_name_en\n       END AS d,\n       action_code AS r\nFROM FND_CHEQUE_ACTION_CATALOG\nWHERE active_flag = 'Y'\nORDER BY display_seq;",
    "return": "R",
    "display": "D"
  },
