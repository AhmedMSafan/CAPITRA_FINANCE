<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1515;CA1062;CA2007;CA1812;CA1852;CA1724;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1707;CA1819;CA1002;CA2227;CA1056;CA1054;CA1711;CA1860;CA1861;CA1822;CA1031</NoWarn>
  </PropertyGroup>
</Project>
